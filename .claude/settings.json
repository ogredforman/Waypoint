{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "go -C \"$CLAUDE_PROJECT_DIR/tools/hooks\" run . guard-edit", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "go -C \"$CLAUDE_PROJECT_DIR/tools/hooks\" run . guard-bash", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "go -C \"$CLAUDE_PROJECT_DIR/tools/hooks\" run . format", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "go -C \"$CLAUDE_PROJECT_DIR/tools/hooks\" run . check", "timeout": 300 }
        ]
      }
    ]
  }
}
